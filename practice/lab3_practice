#1 creation
class HashTable: #define hash map structure
    def __init__(self, size): #init is constructor
        self.size = size #size specifies the number of buckets(slot) in the hash table
        self.hash_table = [[] for _ in range(size)] #create empty lists
    
#2 Insert or Update (set_val)
    def set_val(self, key, val):
        hashed_key = hash(key) % self.size #calculates the bucket index where the key–value pair should be stored.
        bucket = self.hash_table[hashed_key] # retrieves the list at that index

        for index, (record_key, _) in enumerate(bucket): #weather key already exists in the bucket
            if record_key == key: 
                bucket[index] = (key, val) #if found, update existing value
                return
        bucket.append((key, val)) # if key not found, append the new key–value pair to the bucket

#3 Retrieve (get_val)
# Finds the bucket where the key would be.
# Searches for the key in the bucket:
# If found: returns the value.
# If not found: returns "No record found".
    def get_val(self, key):
        hashed_key = hash(key) % self.size
        bucket = self.hash_table[hashed_key]

        for record_key, record_val in bucket:
            if record_key == key:
                return record_val
        return "No record found"

#4 Deletion (delete_val)
# hash(key) % self.size identifies the bucket where the key should exist.
# Searches for the key in the bucket:
# If found: removes the key-value pair.
# If not found: does nothing.
    def delete_val(self, key):
        hashed_key = hash(key) % self.size
        bucket = self.hash_table[hashed_key]

        for index, (record_key, _) in enumerate(bucket):
            if record_key == key:
                bucket.pop(index)
                return

#5. Display (__str__)
    def __str__(self):
        return "".join(str(bucket) for bucket in self.hash_table)
        
ht = HashTable(3) #Creates a new hash table object with 3 empty buckets.
print(ht)
ht.set_val('apple', 10)
ht.set_val('banana', 20)
ht.set_val('cherry', 30)

print("Hash Table:", ht)

print("Value for 'banana':", ht.get_val('banana'))
print("Value for 'apple':", ht.get_val('apple'))

ht.set_val('apple', 50)
print("Updated Hash Table:", ht)

ht.delete_val('banana')
print("After Deletion:", ht)

print("Value for 'banana':", ht.get_val('banana'))
